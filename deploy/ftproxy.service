# /etc/systemd/system/ftproxy.service
# установка:
#   sudo install -m 0755 ftproxy-linux-amd64 /usr/local/bin/ftproxy
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin ftproxy
#   sudo mkdir -p /etc/ftproxy
#   sudo install -m 0640 -o root -g ftproxy config.yaml /etc/ftproxy/config.yaml
#   sudo install -m 0644 deploy/ftproxy.service /etc/systemd/system/ftproxy.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now ftproxy

[Unit]
Description=ftproxy - transparent FTP proxy (IPv4 only, ACL, Prometheus)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ftproxy -config /etc/ftproxy/config.yaml
EnvironmentFile=-/etc/sysconfig/ftproxy

User=ftproxy
Group=ftproxy

# порты <=1023 (например :21) без работы от root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# graceful stop: процесс ловит SIGTERM, дожимает QUIT-ответы и закрывает сессии
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=3

# лог в stdout/stderr, забирает journald (в конфиге log.output: stdout)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ftproxy

# песочница
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET
RestrictNamespaces=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
LockPersonality=true
# если нужен лог-файл вместо journald (log.output в конфиге):
# ReadWritePaths=/var/log/ftproxy

# много коротких дата-соединений + длинные потоки данных
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
